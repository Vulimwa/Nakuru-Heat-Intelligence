# OPEN_ROUTER_API_KEY: Required for OpenRouter AI API calls.
OPEN_ROUTER_API_KEY="MY_OPEN_ROUTER_API_KEY"

# Optional: use a specific OpenRouter model. Defaults to the free router, which selects a currently available free model.
OPENROUTER_MODEL="openrouter/free"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
